    USERS {
        int id PK
        varchar name
        varchar email UK
        varchar password_hash
        enum role
        enum status
        timestamp created_at
        timestamp updated_at
    }

    PROFILES {
        int id PK
        int user_id FK,UK
        varchar phone
        varchar location
        varchar professional_title
        text bio
        text education
        text experience
        enum availability
        varchar portfolio_url
        varchar linkedin_url
        boolean is_public
